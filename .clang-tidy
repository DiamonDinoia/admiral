---
# clang-tidy configuration for admiral (C++20 FFT library).
#
# The set below enables the checks that catch real defects reachable in this code.
# Every check that is OFF gets a one-line reason here or in CheckOptions below.
#
# Run with llvm/19.1.7 and the clang compile_commands.json (sa-audit build).
# The validate.sh `tidy` arm reproduces this exactly.

Checks:
  - '-*'

  # ---- Bugprone: real defect catchers ------------------------------------
  - 'bugprone-assert-side-effect'
  - 'bugprone-bool-pointer-implicit-conversion'
  - 'bugprone-branch-clone'
  - 'bugprone-copy-constructor-init'
  - 'bugprone-dangling-handle'
  - 'bugprone-exception-escape'
  - '-bugprone-implicit-widening-of-multiplication-result'
  # OFF: it flags every unsigned*unsigned assigned to size_t without asking whether
  # the product can overflow. All 15 sites here are compile-time cache-size constants
  # (48u * 1024u) or products bounded by a codelet radix or the register count, so the
  # rewrite is unreachable-overflow noise, and `std::size_t{2} * N` is harder to read
  # than `2u * N`, which is the same reason readability-uppercase-literal-suffix is off.
  - 'bugprone-incorrect-roundings'
  - 'bugprone-infinite-loop'
  - '-bugprone-integer-division'
  # OFF: fires on intentional ceiling-integer-division idioms in cost models
  # (base_cost_model.hpp, twiddles.hpp); every instance is deliberate.
  - 'bugprone-misplaced-operator-in-strlen-in-alloc'
  - 'bugprone-misplaced-widening-cast'
  - 'bugprone-move-forwarding-reference'
  - 'bugprone-multiple-statement-macro'
  - 'bugprone-narrowing-conversions'
  - 'bugprone-no-escape'
  - 'bugprone-not-null-terminated-result'
  - 'bugprone-parent-virtual-call'
  - 'bugprone-posix-return'
  - 'bugprone-reserved-identifier'
  - 'bugprone-signal-handler'
  - 'bugprone-signed-char-misuse'
  - 'bugprone-sizeof-container'
  - 'bugprone-sizeof-expression'
  - 'bugprone-standalone-empty'
  - 'bugprone-string-constructor'
  - 'bugprone-string-integer-assignment'
  - 'bugprone-string-literal-with-embedded-nul'
  - 'bugprone-suspicious-enum-usage'
  - 'bugprone-suspicious-include'
  - 'bugprone-suspicious-memset-usage'
  - 'bugprone-suspicious-missing-comma'
  - 'bugprone-suspicious-semicolon'
  - 'bugprone-suspicious-string-compare'
  - 'bugprone-swapped-arguments'
  - 'bugprone-terminating-continue'
  - 'bugprone-throw-keyword-missing'
  - 'bugprone-too-small-loop-variable'
  - 'bugprone-unchecked-optional-access'
  - 'bugprone-undefined-memory-manipulation'
  - 'bugprone-undelegated-constructor'
  - 'bugprone-unhandled-self-assignment'
  - 'bugprone-unused-return-value'
  - 'bugprone-use-after-move'
  - 'bugprone-virtual-near-miss'
  - '-bugprone-easily-swappable-parameters'
  # OFF: fires on every pair of same-type or convertible function parameters
  # (FFTW shim void*/int pairs, math template APIs); ratio of false positives to
  # true positives is too high for a library with many numeric helpers.
  - '-bugprone-macro-parentheses'
  # OFF: fires on type-substitution macros (ADM_FFTW_SHIM COMPLEX_T parameters)
  # where parenthesising a type token is not valid C++.

  # ---- Performance: real-cost issues -------------------------------------
  - 'performance-avoid-endl'
  - 'performance-faster-string-find'
  - 'performance-for-range-copy'
  - 'performance-implicit-conversion-in-loop'
  - 'performance-inefficient-algorithm'
  - 'performance-inefficient-string-concatenation'
  - 'performance-inefficient-vector-operation'
  - 'performance-move-constructor-init'
  - 'performance-no-automatic-move'
  - 'performance-no-int-to-ptr'
  - 'performance-noexcept-destructor'
  - 'performance-noexcept-move-constructor'
  - 'performance-trivially-destructible'
  - 'performance-type-promotion-in-math-fn'
  - 'performance-unnecessary-copy-initialization'
  - 'performance-unnecessary-value-param'
  - '-performance-enum-size'
  # OFF: enums in the public ABI (effort, adm_status) are int-sized by design;
  # changing the base type would be an ABI break with zero runtime benefit here.

  # ---- Portability -------------------------------------------------------
  - 'portability-restrict-system-includes'
  - 'portability-std-allocator-const'
  - '-portability-simd-intrinsics'
  # OFF: the library targets xsimd which abstracts SIMD, and project policy bans
  # direct intrinsic use (CLAUDE.md). The check is irrelevant.

  # ---- CERT (selected: avoid duplicating bugprone; skip C-file-IO rules) ----
  - 'cert-dcl50-cpp'
  - 'cert-dcl58-cpp'
  - '-cert-err33-c'
  # OFF: the tree ignores exactly two classes of stdio return, both deliberately. One is
  # the fputs/fprintf calls in debug.hpp (a trace that fails to print must not change
  # what the program computes). The other is fclose on the read-only sysfs stream in
  # cache.hpp. Enabling it adds `[[maybe_unused]] auto _ =` at eight sites and finds
  # no defect.
  - 'cert-err52-cpp'
  - 'cert-err60-cpp'
  - 'cert-flp30-c'
  - 'cert-mem57-cpp'
  - 'cert-msc50-cpp'
  - 'cert-msc51-cpp'
  - 'cert-oop58-cpp'
  - '-cert-err34-c'
  # OFF: fires on fscanf in cache.hpp's sysfs CPU-topology reader; using strtoul
  # there would add 20 lines for a parsing path that cannot produce UB (the format
  # string and field width together bound the value). Keep the existing defensive code.

  # ---- Misc (curated) ----------------------------------------------------
  - 'misc-const-correctness'
  - '-misc-no-recursion'
  # OFF: the plan cost estimators ARE recursive by construction. `estimated_plan_cost`
  # descends into `rader_model_cost` and `dif_measured_cost` to price a sub-plan, and the
  # depth is bounded by the factorization, not by input size. The check targets code with a
  # hard stack budget; rewriting these into an explicit stack buys nothing here.
  - 'misc-redundant-expression'
  - 'misc-throw-by-value-catch-by-reference'
  - 'misc-uniqueptr-reset-release'
  - 'misc-unused-alias-decls'
  - 'misc-unused-using-decls'
  - '-misc-include-cleaner'
  # OFF: high-volume false positives for large template headers (every include in
  # each explicit-instantiation TU looks redundant from a single-TU perspective).
  - '-misc-use-anonymous-namespace'
  # OFF: the project has explicit instantiation declarations, and the tree avoids
  # anonymous namespaces inside headers to keep extern-template viable.

  # ---- Readability (defect-catching only, no naming/style rewrites) ------
  - 'readability-avoid-const-params-in-decls'
  # readability-deleted-default was REMOVED from clang-tidy in LLVM 18; the compiler
  # diagnoses the same thing. The control's roster check is what caught it still listed.
  - 'readability-duplicate-include'
  - 'readability-misplaced-array-index'
  - 'readability-redundant-declaration'
  - 'readability-redundant-preprocessor'
  - 'readability-string-compare'
  - '-readability-braces-around-statements'
  # OFF: the hot path uses single-line [[unlikely]] if statements, and adding
  # braces harms layout without changing correctness.
  - '-readability-identifier-length'
  # OFF: math code uses conventional short names (v, i, j, W, T, N, lo, hi ...).
  - '-readability-magic-numbers'
  # OFF: numeric constants are the substance of an FFT cost model; naming every
  # literal would add noise without clarity.
  - '-readability-uppercase-literal-suffix'
  # OFF: `u` suffix is consistent with the existing style; enforcing `U` is
  # mechanical churn.

# Only warn on project headers, not on xsimd/poet/catch2/nanobench.
HeaderFilterRegex: '.*admiral.*'

# Treat warnings as errors in the tidy arm of validate.sh.
WarningsAsErrors: '*'

CheckOptions:
  - key: bugprone-assert-side-effect.AssertMacros
    value: assert
  - key: misc-const-correctness.AnalyzeValues
    value: false
  - key: misc-const-correctness.WarnPointersAsValues
    value: false
...
