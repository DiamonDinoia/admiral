// mixed-radix driver uses for radices). The per-N codelet_apply<N,T,Forward>
// definitions live in codelet_<N>.cpp; the CMake-generated extern-template block
// below keeps THIS TU from re-instantiating the heavy kernel<N> bodies — the
// dispatch only emits external references to them.

#include "codelet_apply.hpp"
#include "admiral/detail/kernels.hpp"  // CODELET_CATALOG_MAX + codelet_dispatch decl

#include <poet/poet.hpp>

namespace admiral {
namespace detail {

// --- extern template declarations (generated, one group per catalog size) ---
@ADM_CODELET_EXTERN@
// Explicit generated catalog as a compile-time sequence.
using codelet_catalog_seq = @ADM_CODELET_SEQUENCE@;

// Functor: turn the runtime N into the compile-time codelet_apply<N> call.
template<typename T, bool Forward>
struct codelet_apply_invoke {
    template<int N>
    void operator()(const std::complex<T>* in, std::complex<T>* out) const {
        codelet_apply<static_cast<unsigned>(N), T, Forward>(in, out);
    }
};

template<typename T, bool Forward>
void codelet_dispatch(const std::complex<T>* in, std::complex<T>* out, std::size_t N) {
    // Catalog extras (sparse sizes beyond the contiguous range) dispatch here so
    // the poet::dispatch below stays a dense jump table over the range (appending
    // them to the sequence degrades it to a compare chain: +12-14 cyc every call).
@ADM_CODELET_EXTRA_DISPATCH@
    poet::dispatch(codelet_apply_invoke<T, Forward>{},
                   poet::dispatch_param<codelet_catalog_seq>{static_cast<int>(N)},
                   in, out);
}

template void codelet_dispatch<float,  true >(const std::complex<float>*,  std::complex<float>*,  std::size_t);
