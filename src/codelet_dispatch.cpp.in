template<typename T, bool Forward>
void codelet_dispatch(const std::complex<T>* in, std::complex<T>* out, std::size_t N) {
    // Catalog extras (sparse sizes beyond the contiguous range) dispatch here so
    // the poet::dispatch below stays a dense jump table over the range (appending
