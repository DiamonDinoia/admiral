// Explicit generated catalog as a compile-time sequence.
using codelet_catalog_seq = @ADM_CODELET_SEQUENCE@;

// Functor: turn the runtime N into the compile-time codelet_apply<N> call.
template<typename T, bool Forward>
struct codelet_apply_invoke {
    template<std::size_t N>
    void operator()(const std::complex<T>* in, std::complex<T>* out) const {
        codelet_apply<N, T, Forward>(in, out);
